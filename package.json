{
  "name": "cam2ocr2speech",
  "version": "1.1.0",
  "main": "main.js",
  "scripts": {
    "start": "electron ."
  },
  "keywords": [],
  "author": "MAudoin",
  "license": "AGPL-3.0-only",
  "description": "",
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "productName": "VocaPage",
    "appId": "com.maudoin.vocapage",
    "icon": "resources/icon256px.ico",
    "win": {
      "target": "msi",
      "artifactName": "${productName}-${version}-windows.${ext}"
    },
    "msi": {
      "oneClick": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "asar": true,
    "compression": "maximum",
    "files": [
      "**/*",
      "!dist/**",
      "!doc/**",
      "!scripts/**",
      "!third-parties/pdf.js/v5.3.93/web/compressed.tracemonkey-pldi-09.pdf",
      "!.gitignore",
      "!package-lock.json"
    ],
    "directories": {
      "output": "dist"
    }
  }
}
